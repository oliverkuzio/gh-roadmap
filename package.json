{
  "name": "@oliverkuzio/gh-roadmap",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.5.2",
  "description": "Plan milestones and stories as markdown in a .github/project folder and sync them to GitHub milestones, issues and a project board",
  "author": "Oliver Kuzio",
  "license": "MIT",
  "keywords": [
    "github",
    "projects",
    "milestones",
    "issues",
    "roadmap",
    "cli"
  ],
  "bin": {
    "gh-roadmap": "./bin/gh-roadmap.mjs"
  },
  "files": [
    "bin",
    "src",
    "template"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev:init": "tsx src/cli.ts init",
    "dev:sync": "tsx src/cli.ts sync",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@octokit/graphql": "^8.2.1",
    "@octokit/rest": "^21.1.1",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-plugin-format": "^1.0.1",
    "typescript": "^5.8.2",
    "vitest": "^5.0.4"
  }
}
